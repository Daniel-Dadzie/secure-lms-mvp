# Database
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/secure_lms_dev

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-64-byte-hex-string
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-byte-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-private-key-here"

# Firebase Web (for frontend FCM)
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Stripe
PLATFORM_CURRENCY=USD
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email (Nodemailer + Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Mech Spec LMS <your-gmail@gmail.com>

# Help Center Chatbot (OpenRouter — get key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
CHATBOT_RETRIEVAL_THRESHOLD=0.15
# Set to 1 to always use the LLM; lower values skip the LLM on strong article matches
CHATBOT_SKIP_LLM_THRESHOLD=1
CHATBOT_LLM_ENABLED=true
# Cache repeated questions locally (TTL minutes) and article context on OpenRouter
CHATBOT_RESPONSE_CACHE_ENABLED=true
CHATBOT_RESPONSE_CACHE_TTL_MINUTES=5
CHATBOT_PROMPT_CACHE_ENABLED=true
