generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  passwordHash        String
  fullName            String
  role                Role                  @default(STUDENT)
  isActive            Boolean               @default(true)
  isEmailVerified     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  avatarUrl           String?
  credentials         String?
  experienceYears     String?
  instructorCategory  String?
  specialization      String?
  bio                 String?
  expertise           String[]
  shortBio            String?
  detectedTimezone    String?
  region              UserRegion?
  Activity            Activity[]
  auditEvents         AuditEvent[]
  cart                Cart?
  certificates        Certificate[]
  couponUsages        CouponUsage[]
  coursesTaught       Course[]              @relation("InstructorCourses")
  emailVerifications  EmailVerification[]
  enrollments         Enrollment[]
  instructorAnalytics InstructorAnalytics[]
  lessonProgress      LessonProgress[]
  notifications       Notification[]
  passwordResets      PasswordReset[]
  purchases           Purchase[]
  quizAttempts        QuizAttempt[]
  refreshTokens       RefreshToken[]
  reviews             Review[]
  savedCourses        SavedCourse[]
  supportMessages     SupportMessage[]
  supportTickets      SupportTicket[]

  @@index([role])
  @@index([region])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())
  description String?
  courses     Course[]

  @@map("categories")
}

model RatingAggregate {
  id        String   @id @default(uuid())
  courseId  String   @unique
  oneStar   Int      @default(0)
  twoStar   Int      @default(0)
  threeStar Int      @default(0)
  fourStar  Int      @default(0)
  fiveStar  Int      @default(0)
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("rating_aggregates")
}

model Course {
  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  description         String
  thumbnailUrl        String?
  priceCents          Int                   @default(0)
  status              CourseStatus          @default(DRAFT)
  isActive            Boolean               @default(true)
  instructorId        String
  categoryId          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  averageRating       Float                 @default(0)
  reviewCount         Int                   @default(0)
  learningObjectives  String[]
  currency            String                @default("USD")
  duration            String?
  highlights          String[]
  level               String?
  longDescription     String?
  cartItems           CartItem[]
  certificates        Certificate[]
  couponUsages        CouponUsage[]
  category            Category?             @relation(fields: [categoryId], references: [id])
  instructor          User                  @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments         Enrollment[]
  instructorAnalytics InstructorAnalytics[]
  modules             Module[]
  purchases           Purchase[]
  quizzes             Quiz[]
  ratingAggregate     RatingAggregate?
  reviews             Review[]
  savedBy             SavedCourse[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duration  String?
  lessons   Lesson[]
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String            @id @default(uuid())
  moduleId        String
  title           String
  contentType     LessonContentType @default(VIDEO)
  contentUrl      String?
  contentText     String?
  durationSeconds Int               @default(0)
  order           Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  progress        LessonProgress[]
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes         Quiz[]

  @@index([moduleId])
  @@map("lessons")
}

model Purchase {
  id                String         @id @default(uuid())
  userId            String
  courseId          String
  amountCents       Int
  currency          String         @default("USD")
  status            PurchaseStatus @default(PENDING)
  provider          String         @default("PAYSTACK")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  couponId          String?
  discountCents     Int            @default(0)
  finalAmountCents  Int
  providerReference String?
  buyerRegion       UserRegion?
  buyerTimezone     String?
  couponUsage       CouponUsage?
  enrollment        Enrollment?
  course            Course         @relation(fields: [courseId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([providerReference])
  @@map("purchases")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  courseId  String
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@index([cartId])
  @@map("cart_items")
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  purchaseId  String?          @unique
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id])
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  progress    LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id              String               @id @default(uuid())
  userId          String
  lessonId        String
  enrollmentId    String
  status          LessonProgressStatus @default(NOT_STARTED)
  progressSeconds Int                  @default(0)
  completedAt     DateTime?
  updatedAt       DateTime             @updatedAt
  enrollment      Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  courseId          String
  certificateNumber String   @unique @default(cuid())
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@map("certificates")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?

  instructorReply String? @db.Text
  instructorReplyAt DateTime?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("reviews")
}

model SavedCourse {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("saved_courses")
}

model Quiz {
  id          String        @id @default(uuid())
  lessonId    String?
  courseId    String
  title       String
  description String?
  passMark    Int           @default(70)
  timeLimit   Int?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  questions   Question[]
  attempts    QuizAttempt[]
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  text          String
  options       Json
  correctOption String
  order         Int
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id          String            @id @default(uuid())
  quizId      String
  userId      String
  answers     Json?
  score       Int?
  passed      Boolean?
  completedAt DateTime?
  startedAt   DateTime          @default(now())
  status      QuizAttemptStatus @default(IN_PROGRESS)
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  discountType  DiscountType
  discountValue Int
  maxUses       Int?
  usedCount     Int           @default(0)
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  usages        CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  courseId   String
  purchaseId String   @unique
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model InstructorAnalytics {
  id              String   @id @default(uuid())
  instructorId    String
  courseId        String
  date            DateTime @db.Date
  enrollmentCount Int      @default(0)
  completionCount Int      @default(0)
  revenuecents    Int      @default(0)
  averageProgress Float    @default(0)
  createdAt       DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor      User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, courseId, date])
  @@index([instructorId])
  @@index([courseId])
  @@map("instructor_analytics")
}

model HelpArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("help_articles")
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String?
  subject   String
  status    TicketStatus     @default(OPEN)
  priority  TicketPriority   @default(NORMAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
  user      User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  senderId  String?
  body      String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  sender    User?         @relation(fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Activity {
  id          String   @id @default(uuid())
  userId      String
  title       String
  metadata  Json?
  description String?
  iconType    String
  createdAt   DateTime @default(now())
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum UserRegion {
  NORTH_AMERICA
  LATIN_AMERICA
  EUROPE
  AFRICA
  MIDDLE_EAST
  ASIA_PACIFIC
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationType {
  ENROLLMENT_CONFIRMED
  CERTIFICATE_ISSUED
  NEW_REVIEW
  SUPPORT_TICKET_NEW
  SUPPORT_TICKET_UPDATED
  SUPPORT_TICKET_CLOSED
  SUPPORT_TICKET_MESSAGE
  PLATFORM_ALERT
  NEW_ENROLLMENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum LessonContentType {
  VIDEO
  TEXT
}
