// ============================================================================
// Secure LMS MVP — Database Schema
// ============================================================================
// System engineering notes (read before modifying):
//
// 1. MONEY: all monetary values are stored as Int (minor units / cents), never
//    Float — floating point cannot represent currency exactly and will drift
//    over enough transactions. $19.99 is stored as 1999.
//
// 2. SOFT DELETE on User, Course, Purchase: financial and audit records must
//    remain queryable after a user is "deleted" (legal/audit trail, refund
//    history). We flag records inactive (isActive / status) instead of hard
//    deleting. Lesson/Module content can hard-delete since it carries no
//    financial or audit weight.
//
// 3. AUDIT EVENTS are append-only by design: no updatedAt field, and the
//    application layer must never expose UPDATE or DELETE operations on this
//    table. Treat it as a write-once log, not a mutable record.
//
// 4. ROLE is a simple enum on User, not a joined Role table. RBAC checks run
//    on nearly every authenticated request — a denormalized enum avoids a
//    join on that hot path. If multi-role-per-user becomes a real requirement
//    post-MVP, migrate to a UserRole join table then; don't pay that
//    complexity cost now.
//
// 5. STORAGE BOUNDARY: this schema stores only *references* (URLs/paths) to
//    files in Firebase Storage (thumbnails, lesson video). Postgres never
//    stores file bytes — that's a deliberate system boundary between the
//    transactional store and the blob store.
//
// 6. Every entity carries createdAt (and updatedAt where mutable) — this is
//    non-negotiable for a platform the security team is threat-modeling;
//    timestamps are the minimum viable audit trail even before AuditEvent
//    entries exist for a given action.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    
}

// ----------------------------------------------------------------------------
// Enums — explicit state machines instead of free-text status strings.
// Invalid states become unrepresentable at the DB level.
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ----------------------------------------------------------------------------
// Users & Roles
// ----------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String // bcrypt hash only — never plaintext, never returned by API serializers
  fullName        String
  role            Role     @default(STUDENT)
  isActive        Boolean  @default(true) // soft delete flag — see header note
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  coursesTaught    Course[]         @relation("InstructorCourses")
  purchases        Purchase[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  refreshTokens    RefreshToken[]
  auditEvents      AuditEvent[]
  certificates     Certificate[]
  cart             Cart?
  reviews          Review[]
  savedCourses        SavedCourse[]
  quizAttempts        QuizAttempt[]
  couponUsages        CouponUsage[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  instructorAnalytics InstructorAnalytics[]
  notifications       Notification[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family      String    // groups tokens for reuse detection — revoke whole family on replay
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// Catalogue: Category, Course, Module, Lesson
// ----------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  courses Course[]

  @@map("categories")
}

model RatingAggregate {
  id          String   @id @default(uuid())
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  oneStar     Int      @default(0)
  twoStar     Int      @default(0)
  threeStar   Int      @default(0)
  fourStar    Int      @default(0)
  fiveStar    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("rating_aggregates")
}
model Course {
  id           String       @id @default(uuid())
  title        String
  slug         String       @unique
  description  String
  learningObjectives String[]
// Stored as a Postgres array of strings.
// e.g. ["Understand AutoCAD interface", "Create 2D drawings"]
// Array type avoids a separate CourseObjective join table for MVP
// while remaining queryable and extendable.
  thumbnailUrl String? // Firebase Storage reference — see header note
  priceCents   Int          @default(0) // stored in cents; see header note
  status       CourseStatus @default(DRAFT)
  isActive     Boolean      @default(true) // soft delete flag
  averageRating  Float    @default(0)
  reviewCount    Int      @default(0)


  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: an instructor cannot be hard-deleted while they
  // still own courses with purchase/enrollment history attached.

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ratingAggregate RatingAggregate?
  cartItems CartItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     Module[]
  purchases   Purchase[]
  enrollments Enrollment[]
  certificates Certificate[]
  reviews      Review[]
  savedBy             SavedCourse[]
  quizzes             Quiz[]
  couponUsages        CouponUsage[]
  instructorAnalytics InstructorAnalytics[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Cascade is correct here: a module has no meaning or audit weight
  // independent of its parent course.
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String   @id @default(uuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  contentUrl      String? // Firebase Storage reference (video/asset) — see header note
  durationSeconds Int      @default(0)
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress LessonProgress[]
  quizzes Quiz[]

  @@index([moduleId])
  @@map("lessons")
}

// ----------------------------------------------------------------------------
// Commerce: Purchase, Enrollment
// ----------------------------------------------------------------------------

model Purchase {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  amountCents  Int
  currency     String         @default("GHS")
  status       PurchaseStatus @default(PENDING)
  provider     String         @default("PAYSTACK")
  providerReference String?
  // Not unique — cart checkout creates multiple Purchase rows sharing one
  // Paystack reference (one payment, several courses). Indexed for the
  // webhook lookup, which queries "all purchases with this reference".
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  enrollment Enrollment?
  couponUsage CouponUsage?
  couponId         String?
  discountCents    Int     @default(0)
  finalAmountCents Int

  @@index([userId])
  @@index([status])
  @@index([providerReference])
  @@map("purchases")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // A course can only appear once per cart
  @@unique([cartId, courseId])
  @@index([cartId])
  @@map("cart_items")
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchaseId String?          @unique // nullable: free-course enrollment has no purchase
  purchase   Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  completedAt DateTime?

  progress LessonProgress[]

  // A user can only enroll in a given course once — enforced at the DB
  // level, not just in application logic.
  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// ----------------------------------------------------------------------------
// Progress tracking
// ----------------------------------------------------------------------------

model LessonProgress {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status          LessonProgressStatus  @default(NOT_STARTED)
  progressSeconds Int                   @default(0)
  completedAt     DateTime?
  updatedAt       DateTime              @updatedAt

  @@unique([userId, lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

model Certificate {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Restrict: certificate records must survive even if user is deactivated —
  // they're proof of achievement and may be referenced externally.
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  // Restrict: same reason — a certificate can't silently disappear because
  // a course was archived after the student completed it.
  certificateNumber String @unique @default(cuid())
  // Human-readable unique ID printed on the certificate itself.
  // cuid() gives a collision-resistant, URL-safe string.
  issuedAt     DateTime @default(now())

  // A student earns one certificate per course — no duplicates.
  @@unique([userId, courseId])
  @@index([userId])
  @@map("certificates")
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  // Restrict on both sides: reviews are permanent records of student feedback.
  // A deleted/archived course or deactivated user must not silently erase reviews.
  rating       Int
  // Rating stored as integer 1-5. Enforced at application layer via Zod (min 1, max 5).
  // DB-level check constraint added in migration for extra safety.
  comment      String?
  // Comment is optional — a student can leave a star rating without written feedback.
  isVisible    Boolean  @default(true)
  // Soft hide: admin can hide inappropriate reviews without deleting them.
  // Audit trail preserved.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A student can only review a course once — enforced at DB level.
  // Must be enrolled to review (enforced at application layer).
  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("reviews")
}

// save course

model SavedCourse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // A student can only save a course once
  @@unique([userId, courseId])
  @@index([userId])
  @@map("saved_courses")
}

model Quiz {
  id          String   @id @default(uuid())
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  passMark    Int      @default(70)
  // Pass mark stored as percentage integer (70 = 70%)
  timeLimit   Int?
  // Time limit in seconds — null means no limit
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text          String
  // Options stored as JSON array:
  // [{ "id": "a", "text": "Option A" }, { "id": "b", "text": "Option B" }]
  options       Json
  correctOption String
  // Stores the option id (e.g. "a") — never exposed to students before submission
  order         Int
  createdAt     DateTime @default(now())

  @@index([quizId])
  @@map("questions")
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}


model QuizAttempt {
  id          String            @id @default(uuid())
  quizId      String
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  // Answers stored as JSON once submitted: { "questionId": "selected_option_id" }
  // Null while IN_PROGRESS — nothing has been graded yet.
  answers     Json?
  score       Int?
  // Score stored as percentage integer (85 = 85%). Null until submitted.
  passed      Boolean?
  completedAt DateTime?
  // Null until submitted or expired.

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

// coupons and discount
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  // For PERCENTAGE: value is 0-100 (e.g. 20 = 20% off)
  // For FIXED_AMOUNT: value is in cents (e.g. 500 = $5.00 off)
  maxUses       Int?
  // null means unlimited uses
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  // null means never expires
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([couponId, userId])
  @@map("coupon_usages")
}

// email verification
model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Token is a random UUID — hashed before storage
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
   
  

  @@index([userId])
  @@map("email_verifications")
}

// password reset
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

// instructor Analytics
model InstructorAnalytics {
  id               String   @id @default(uuid())
  instructorId     String
  instructor       User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  // Snapshot date — one row per instructor per course per day
  enrollmentCount  Int      @default(0)
  completionCount  Int      @default(0)
  revenuecents     Int      @default(0)
  averageProgress  Float    @default(0)
  createdAt        DateTime @default(now())

  @@unique([instructorId, courseId, date])
  @@index([instructorId])
  @@index([courseId])
  @@map("instructor_analytics")
}

// help article
model HelpArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String
  // e.g. "getting-started", "payments", "courses", "account"
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("help_articles")
}



// ----------------------------------------------------------------------------
// Audit trail — append-only. See header note #3.
// ----------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String? // nullable: some events are system-triggered, not user-triggered
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "course.publish", "auth.login_failed", "enrollment.create"
  entityType String? // e.g. "Course", "User", "Purchase"
  entityId   String?
  metadata   Json? // structured details specific to the action
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  // No updatedAt — this table is intentionally write-once.

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}


enum NotificationType {
  ENROLLMENT_CONFIRMED
  CERTIFICATE_ISSUED
  NEW_REVIEW
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}